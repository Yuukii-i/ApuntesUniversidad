---
import Base from '../../layouts/Base.astro';
import ClassTile from '../../components/ClassTile.astro';
import { getClasses, getClassTopics } from '../../lib/content';

const classes = await getClasses();

const classTopicsCounts = await Promise.all(
  classes.map(async (c) => {
    const topics = await getClassTopics(c.id);
    return { id: c.id, count: topics.length };
  })
);
const topicCountMap = new Map(classTopicsCounts.map((item) => [item.id, item.count]));

const totalCount = classes.length;
const totalClassesText = totalCount === 1 ? '1 CLASE' : `${totalCount} CLASES`;
---

<Base title="Clases" description="Índice de materias y asignaturas disponibles.">
  <div class="pt-4 sm:pt-8 pb-16">
    <div class="flex items-baseline justify-between mb-8 sm:mb-10">
      <h1 class="text-3xl sm:text-4xl lg:text-[clamp(2.4rem,2.8vw,3rem)] font-bold tracking-[-0.03em] text-text">
        Clases<span class="text-accent">.</span>
      </h1>
      <span class="font-mono text-xs sm:text-sm uppercase tracking-[0.14em] text-muted font-medium">
        {totalClassesText}
      </span>
    </div>

    {
      classes.length === 0 ? (
        <p class="text-muted">Todavía no hay clases disponibles.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(28rem,1fr))] gap-[1.6rem]">
          {classes.map((c) => (
            <ClassTile
              id={c.id}
              title={c.data.title}
              color={c.data.color}
              art={c.data.art}
              topicCount={topicCountMap.get(c.id) ?? 0}
            />
          ))}
        </div>
      )
    }
  </div>
</Base>
