---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import Icon from '../../components/Icon.astro';
import { getClasses, getClassTopics, topicSlugOf } from '../../lib/content';
import { getClassUpdatedISO, formatDateTimeEs } from '../../lib/lastUpdate';

export async function getStaticPaths() {
  const classes = await getClasses();

  return await Promise.all(
    classes.map(async (clase) => ({
      params: { clase: clase.id },
      props: {
        clase,
        topics: await getClassTopics(clase.id),
      },
    }))
  );
}

interface Props {
  clase: CollectionEntry<'classes'>;
  topics: CollectionEntry<'topics'>[];
}

const { clase, topics } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const lastUpdateISO = getClassUpdatedISO(clase.id);
const formattedDate = formatDateTimeEs(lastUpdateISO);
const classColorVar = `var(--class-${clase.data.color})`;
---

<Base title={clase.data.title} description={clase.data.description}>
  <div class="max-w-[56rem] mx-auto pt-2 sm:pt-6 pb-16">
    <!-- Banner de la clase -->
    <div class="relative h-36 sm:h-44 md:h-[13rem] rounded-3xl overflow-hidden mb-6 sm:mb-8 shadow-sm">
      <CoverArt art={clase.data.art} color={clase.data.color} variant="banner" class="w-full h-full rounded-3xl" />

      <div class="absolute left-5 sm:left-8 bottom-5 sm:bottom-7 right-5 sm:right-8 z-10 pointer-events-none">
        <div class="font-mono text-xs sm:text-sm uppercase tracking-[0.14em] text-muted mb-2">
          ACTUALIZADA {formattedDate}
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[clamp(2.4rem,3.6vw,3.6rem)] font-bold tracking-[-0.04em] text-text leading-tight">
          {clase.data.title}
        </h1>
      </div>
    </div>

    <!-- Descripción de la clase -->
    <p class="text-muted text-base sm:text-lg leading-[1.65] max-w-[46rem] mb-8 sm:mb-10">
      {clase.data.description}
    </p>

    <!-- Lista de temas -->
    {
      topics.length === 0 ? (
        <p class="text-muted">Esta clase aún no tiene temas.</p>
      ) : (
        <div class="space-y-1 sm:space-y-2">
          {topics.map((topic) => {
            const topicSlug = topicSlugOf(topic.id);
            const orderPadded = String(topic.data.order).padStart(2, '0');

            return (
              <a
                href={`${baseUrl}/${clase.id}/${topicSlug}/`}
                class="group grid grid-cols-[2.5rem_1fr_auto_auto] sm:grid-cols-[3rem_1fr_auto_auto] gap-3 sm:gap-4 items-baseline p-3 sm:p-4 -mx-3 sm:-mx-4 rounded-xl sm:rounded-2xl hover:bg-surface focus-visible:bg-surface focus-visible:outline-none transition-colors"
                style={`--class-accent: ${classColorVar};`}
              >
                <div class="font-mono text-sm sm:text-base text-muted/60 group-hover:text-[var(--class-accent)] transition-colors">
                  {orderPadded}
                </div>

                <div class="text-base sm:text-lg md:text-[1.45rem] font-semibold tracking-[-0.015em] text-text leading-snug">
                  {topic.data.title}
                </div>

                {topic.data.minutes && (
                  <div class="font-mono text-xs sm:text-sm text-muted text-right whitespace-nowrap pl-2">
                    {topic.data.minutes} min
                  </div>
                )}

                <div class="text-muted/60 group-hover:text-[var(--class-accent)] transition-colors pl-2 self-center">
                  <Icon name="arrow-right" size={16} />
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</Base>
