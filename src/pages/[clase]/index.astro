---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getClasses, topicsOfClass, topicSlugOf } from '../../lib/content';
import { getLastUpdate, formatDateEs } from '../../lib/lastUpdate';

export async function getStaticPaths() {
  const classes = await getClasses();
  const allTopics = await getCollection('topics');

  return classes.map((clase) => ({
    params: { clase: clase.id },
    props: {
      clase,
      topics: topicsOfClass(allTopics, clase.id),
    },
  }));
}

interface Props {
  clase: CollectionEntry<'classes'>;
  topics: CollectionEntry<'topics'>[];
}

const { clase, topics } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const lastUpdate = getLastUpdate(clase.id);
const formattedDate = formatDateEs(lastUpdate);
---

<Base title={clase.data.title} description={clase.data.description}>
  <div class="space-y-8 max-w-4xl mx-auto">
    <!-- Encabezado de la clase -->
    <header class="bg-surface p-8 rounded-xl">
      <div class="flex items-center gap-2 mb-3">
        <span
          class="w-3.5 h-3.5 rounded-full inline-block"
          style={clase.data.accent ? `background-color: ${clase.data.accent}` : 'background-color: var(--accent)'}
        ></span>
        <span class="text-xs font-semibold uppercase tracking-wider text-muted">
          Materia
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-3">
        {clase.data.title}
      </h1>
      <p class="text-muted text-base leading-relaxed mb-4">
        {clase.data.description}
      </p>
      <div class="text-xs text-muted">
        Última actualización: {formattedDate}
      </div>
    </header>

    <!-- Listado de temas o mensaje de vacío -->
    <section aria-labelledby="topics-heading">
      <h2 id="topics-heading" class="text-xl font-bold text-text mb-4 px-1">
        Temas de estudio
      </h2>

      {
        topics.length === 0 ? (
          <div class="bg-surface p-8 rounded-xl text-center">
            <p class="text-muted">Esta clase aún no tiene temas.</p>
          </div>
        ) : (
          <div class="space-y-4">
            {topics.map((topic) => {
              const topicSlug = topicSlugOf(topic.id);
              const href = `${baseUrl}/${clase.id}/${topicSlug}/`;
              return (
                <a
                  href={href}
                  class="group block p-6 rounded-xl bg-surface hover:bg-surface-2 transition-all"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <div class="text-xs font-semibold text-accent mb-1">
                        Tema {topic.data.order}
                      </div>
                      <h3 class="text-lg font-bold text-text group-hover:text-accent transition-colors mb-2">
                        {topic.data.title}
                      </h3>
                      {topic.data.summary && (
                        <p class="text-muted text-sm leading-relaxed">
                          {topic.data.summary}
                        </p>
                      )}
                    </div>
                    <Icon name="chevron-right" size={16} class="text-muted group-hover:text-accent group-hover:translate-x-1 transition-all shrink-0 mt-1" />
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </section>

    <!-- Enlace para volver a la página principal -->
    <div class="pt-4">
      <a
        href={`${baseUrl}/`}
        class="inline-flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors"
      >
        <Icon name="chevron-left" size={16} />
        <span>Volver a todas las materias</span>
      </a>
    </div>
  </div>
</Base>
