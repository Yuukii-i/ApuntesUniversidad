---
import type { ClassArt, ClassColor } from '../lib/classStyle';

interface Props {
  art: ClassArt;
  color: ClassColor;
  variant: 'thumb' | 'tile' | 'banner';
  class?: string;
}

const { art, color, variant, class: className = '' } = Astro.props;

// Guard so hidden SVG symbols are rendered once per page
const locals = Astro.locals as Record<string, any>;
const renderDefs = !locals._coverArtSymbolsEmitted;
if (renderDefs) {
  locals._coverArtSymbolsEmitted = true;
}

const bgStyle = `background: linear-gradient(135deg, color-mix(in oklab, var(--class-${color}) 24%, var(--bg)), color-mix(in oklab, var(--class-${color}) 6%, var(--bg))); color: var(--class-${color});`;

const isThumb = variant === 'thumb';
const showScrim = variant === 'tile' || variant === 'banner';
const strokeWidth = isThumb ? '1.6px' : '1.5px';

const svgConfig = isThumb
  ? {
      classes: 'absolute inset-[8%] w-[84%] h-[84%] opacity-90 pointer-events-none',
      preserveAspectRatio: 'xMidYMid meet',
    }
  : {
      classes: 'absolute top-0 right-0 w-[60%] h-[70%] opacity-45 pointer-events-none',
      preserveAspectRatio: 'xMaxYMin meet',
    };

const scrimStyle = `background: linear-gradient(to top, color-mix(in srgb, color-mix(in oklab, var(--class-${color}) 18%, var(--bg)) 85%, transparent) 0%, transparent 65%);`;
---

{
  renderDefs && (
    <svg width="0" height="0" class="sr-only absolute" aria-hidden="true">
      <defs>
        <symbol id="art-diagram">
          <g fill="none" stroke="currentColor" stroke-width="var(--cover-art-stroke-width, 1.6px)" stroke-linecap="round" stroke-linejoin="round">
            <rect x="14" y="12" width="64" height="34" rx="3" vector-effect="non-scaling-stroke" />
            <line x1="22" y1="24" x2="58" y2="24" vector-effect="non-scaling-stroke" />
            <line x1="22" y1="33" x2="46" y2="33" vector-effect="non-scaling-stroke" />
            <rect x="122" y="12" width="64" height="34" rx="3" fill="currentColor" fill-opacity=".16" vector-effect="non-scaling-stroke" />
            <line x1="130" y1="24" x2="166" y2="24" vector-effect="non-scaling-stroke" />
            <line x1="130" y1="33" x2="152" y2="33" vector-effect="non-scaling-stroke" />
            <rect x="68" y="84" width="64" height="34" rx="3" vector-effect="non-scaling-stroke" />
            <line x1="76" y1="96" x2="112" y2="96" vector-effect="non-scaling-stroke" />
            <line x1="76" y1="105" x2="100" y2="105" vector-effect="non-scaling-stroke" />
            <path d="M46 46 V66 H100 V84" vector-effect="non-scaling-stroke" />
            <path d="M154 46 V66 H100" vector-effect="non-scaling-stroke" />
            <circle cx="100" cy="66" r="2.6" fill="currentColor" />
          </g>
        </symbol>

        <symbol id="art-chip">
          <g fill="none" stroke="currentColor" stroke-width="var(--cover-art-stroke-width, 1.6px)" stroke-linecap="round" stroke-linejoin="round">
            <rect x="72" y="35" width="56" height="56" rx="4" fill="currentColor" fill-opacity=".14" vector-effect="non-scaling-stroke" />
            <rect x="86" y="49" width="28" height="28" rx="2" vector-effect="non-scaling-stroke" />
            <path d="M80 35V22M92 35V16M104 35V16M116 35V22" vector-effect="non-scaling-stroke" />
            <path d="M80 91V104M92 91V114M104 91V114M116 91V104" vector-effect="non-scaling-stroke" />
            <path d="M72 46H48V30H20M72 58H34M72 70H34M72 82H48V98H20" vector-effect="non-scaling-stroke" />
            <path d="M128 46H152V30H180M128 58H166M128 70H166M128 82H152V98H180" vector-effect="non-scaling-stroke" />
            <circle cx="20" cy="30" r="2.4" fill="currentColor" />
            <circle cx="20" cy="98" r="2.4" fill="currentColor" />
            <circle cx="180" cy="30" r="2.4" fill="currentColor" />
            <circle cx="180" cy="98" r="2.4" fill="currentColor" />
          </g>
        </symbol>

        <symbol id="art-network">
          <g fill="none" stroke="currentColor" stroke-width="var(--cover-art-stroke-width, 1.6px)" stroke-linecap="round" stroke-linejoin="round">
            <line x1="38" y1="46" x2="88" y2="28" vector-effect="non-scaling-stroke" />
            <line x1="88" y1="28" x2="152" y2="38" vector-effect="non-scaling-stroke" />
            <line x1="38" y1="46" x2="58" y2="96" vector-effect="non-scaling-stroke" />
            <line x1="58" y1="96" x2="114" y2="78" vector-effect="non-scaling-stroke" />
            <line x1="88" y1="28" x2="114" y2="78" vector-effect="non-scaling-stroke" />
            <line x1="114" y1="78" x2="152" y2="38" vector-effect="non-scaling-stroke" />
            <line x1="114" y1="78" x2="164" y2="94" vector-effect="non-scaling-stroke" />
            <line x1="152" y1="38" x2="164" y2="94" vector-effect="non-scaling-stroke" />
            <circle cx="38" cy="46" r="4.5" vector-effect="non-scaling-stroke" />
            <circle cx="88" cy="28" r="4.5" vector-effect="non-scaling-stroke" />
            <circle cx="152" cy="38" r="6.5" fill="currentColor" fill-opacity=".15" vector-effect="non-scaling-stroke" />
            <circle cx="58" cy="96" r="4.5" vector-effect="non-scaling-stroke" />
            <circle cx="114" cy="78" r="5" vector-effect="non-scaling-stroke" />
            <circle cx="164" cy="94" r="4.5" vector-effect="non-scaling-stroke" />
          </g>
        </symbol>

        <symbol id="art-code">
          <g fill="none" stroke="currentColor" stroke-width="var(--cover-art-stroke-width, 1.6px)" stroke-linecap="round" stroke-linejoin="round">
            <rect x="58" y="26" width="84" height="78" rx="4" fill="currentColor" fill-opacity=".15" vector-effect="non-scaling-stroke" />
            <line x1="72" y1="46" x2="116" y2="46" vector-effect="non-scaling-stroke" />
            <line x1="72" y1="65" x2="130" y2="65" vector-effect="non-scaling-stroke" />
            <line x1="72" y1="84" x2="104" y2="84" vector-effect="non-scaling-stroke" />
            <path d="M42 45 L22 65 L42 85" vector-effect="non-scaling-stroke" />
            <path d="M158 45 L178 65 L158 85" vector-effect="non-scaling-stroke" />
          </g>
        </symbol>

        <symbol id="art-database">
          <g fill="none" stroke="currentColor" stroke-width="var(--cover-art-stroke-width, 1.6px)" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="100" cy="32" rx="48" ry="14" fill="currentColor" fill-opacity=".15" vector-effect="non-scaling-stroke" />
            <path d="M52 32 v22 c0 7.7 21.5 14 48 14 s48 -6.3 48 -14 v-22" vector-effect="non-scaling-stroke" />
            <path d="M52 60 v22 c0 7.7 21.5 14 48 14 s48 -6.3 48 -14 v-22" vector-effect="non-scaling-stroke" />
            <path d="M52 88 v22 c0 7.7 21.5 14 48 14 s48 -6.3 48 -14 v-22" vector-effect="non-scaling-stroke" />
          </g>
        </symbol>

        <symbol id="art-layers">
          <g fill="none" stroke="currentColor" stroke-width="var(--cover-art-stroke-width, 1.6px)" stroke-linecap="round" stroke-linejoin="round">
            <path d="M100 18 L160 42 L100 66 L40 42 Z" fill="currentColor" fill-opacity=".15" vector-effect="non-scaling-stroke" />
            <path d="M40 58 L100 82 L160 58" vector-effect="non-scaling-stroke" />
            <path d="M40 76 L100 100 L160 76" vector-effect="non-scaling-stroke" />
            <path d="M40 94 L100 118 L160 94" vector-effect="non-scaling-stroke" />
          </g>
        </symbol>

        <symbol id="art-math">
          <g fill="none" stroke="currentColor" stroke-width="var(--cover-art-stroke-width, 1.6px)" stroke-linecap="round" stroke-linejoin="round">
            <line x1="28" y1="106" x2="176" y2="106" vector-effect="non-scaling-stroke" />
            <line x1="42" y1="116" x2="42" y2="18" vector-effect="non-scaling-stroke" />
            <path d="M42 106 C66 106, 80 102, 96 66 C104 48, 112 32, 122 32 C132 32, 140 48, 148 66 C164 102, 178 106, 188 106 Z" fill="currentColor" fill-opacity=".15" vector-effect="non-scaling-stroke" />
            <circle cx="86" cy="86" r="2.5" fill="currentColor" />
            <circle cx="122" cy="32" r="2.8" fill="currentColor" />
            <circle cx="158" cy="86" r="2.5" fill="currentColor" />
          </g>
        </symbol>

        <symbol id="art-grid">
          <g fill="none" stroke="currentColor" stroke-width="var(--cover-art-stroke-width, 1.6px)" stroke-linecap="round" stroke-linejoin="round">
            <rect x="60" y="25" width="40" height="40" rx="3" fill="currentColor" fill-opacity=".15" vector-effect="non-scaling-stroke" />
            <line x1="60" y1="25" x2="140" y2="25" vector-effect="non-scaling-stroke" />
            <line x1="60" y1="25" x2="60" y2="105" vector-effect="non-scaling-stroke" />
            <line x1="60" y1="65" x2="140" y2="65" vector-effect="non-scaling-stroke" />
            <line x1="100" y1="25" x2="100" y2="105" vector-effect="non-scaling-stroke" />
            <line x1="100" y1="65" x2="140" y2="105" vector-effect="non-scaling-stroke" />
            <circle cx="60" cy="25" r="2.6" fill="currentColor" />
            <circle cx="100" cy="25" r="2.6" fill="currentColor" />
            <circle cx="140" cy="25" r="2.6" fill="currentColor" />
            <circle cx="60" cy="65" r="2.6" fill="currentColor" />
            <circle cx="100" cy="65" r="3" fill="currentColor" />
            <circle cx="140" cy="65" r="2.6" fill="currentColor" />
            <circle cx="60" cy="105" r="2.6" fill="currentColor" />
            <circle cx="100" cy="105" r="2.6" fill="currentColor" />
            <circle cx="140" cy="105" r="2.6" fill="currentColor" />
          </g>
        </symbol>
      </defs>
    </svg>
  )
}

<div class={`relative overflow-hidden ${className}`} style={bgStyle}>
  <svg
    viewBox="0 0 200 130"
    preserveAspectRatio={svgConfig.preserveAspectRatio}
    class={svgConfig.classes}
    style={`--cover-art-stroke-width: ${strokeWidth}; stroke-width: ${strokeWidth};`}
    aria-hidden="true"
  >
    <use href={`#art-${art}`} />
  </svg>

  {showScrim && (
    <div
      class="absolute inset-0 pointer-events-none"
      style={scrimStyle}
      aria-hidden="true"
    />
  )}

  <slot />
</div>

<style>
  :global([id^="art-"] path),
  :global([id^="art-"] rect),
  :global([id^="art-"] line),
  :global([id^="art-"] ellipse),
  :global([id^="art-"] circle[stroke]) {
    vector-effect: non-scaling-stroke;
  }
</style>
