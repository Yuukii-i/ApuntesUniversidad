---
import Icon from './Icon.astro';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Cambiar tema de color"
  title="Cambiar tema"
  class="p-2 rounded-xl text-muted hover:text-text hover:bg-surface transition-colors flex items-center justify-center cursor-pointer"
>
  <span id="theme-toggle-moon" class="hidden">
    <Icon name="moon" size={18} />
  </span>
  <span id="theme-toggle-sun" class="hidden">
    <Icon name="sun" size={18} />
  </span>
</button>

<script is:inline>
  function updateThemeUI() {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const moon = document.getElementById('theme-toggle-moon');
    const sun = document.getElementById('theme-toggle-sun');
    if (isLight) {
      sun?.classList.remove('hidden');
      moon?.classList.add('hidden');
    } else {
      moon?.classList.remove('hidden');
      sun?.classList.add('hidden');
    }
  }

  function toggleTheme() {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    if (isLight) {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('theme', 'dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('theme', 'light');
    }
    updateThemeUI();
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  updateThemeUI();
</script>
