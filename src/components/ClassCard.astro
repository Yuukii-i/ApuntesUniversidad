---
import { getLastUpdate, formatDateEs } from '../lib/lastUpdate';

interface Props {
  id: string;
  title: string;
  description: string;
  accent?: string;
}

const { id, title, description, accent } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${baseUrl}/${id}/`;
const lastUpdate = getLastUpdate(id);
const formattedDate = formatDateEs(lastUpdate);
---

<a
  href={href}
  class="group block p-6 rounded-xl bg-surface hover:bg-surface-2 transition-all shadow-sm"
>
  <div class="flex items-center gap-2 mb-3">
    <span
      class="w-3 h-3 rounded-full inline-block shrink-0"
      style={accent ? `background-color: ${accent}` : 'background-color: var(--accent)'}
    ></span>
    <h2 class="text-xl font-bold text-text group-hover:text-accent transition-colors">
      {title}
    </h2>
  </div>
  <p class="text-muted text-sm leading-relaxed mb-4">
    {description}
  </p>
  <div class="text-xs text-muted">
    Última actualización: {formattedDate}
  </div>
</a>
